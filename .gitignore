# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# setuptools editable-install metadata
*.egg-info/

# Virtual Environments
.venv/
# Root-level legacy env dir only. Anchored (Step-07 PR0): the unanchored form
# also ignored the tracked example pack `examples/tidmad/`.
/tidmad/
venv/
env/
*.env

# Data and Binary files
*.npy
*.pth
*.pdf
reports/

# Root-paper resolution cache written at runtime by the ml_literature_review
# node (reference_data/ is otherwise tracked; these JSONs are not source).
# README.md is tracked so future operators see the cache contract;
# everything else in this directory is the production cache content.
reference_data/root_papers_cache/*
!reference_data/root_papers_cache/README.md

# §10 Phase-1 pilot cache (Commit 2c-c.2). Committed reports live under
# docs/validation_suite_runs.md once promoted; the cache holds raw arXiv
# tarballs + intermediate JSON + the unpromoted rendered report, which are
# not source. Per docs/external_agents_architecture.md §8: each external
# agent owns its own reference_data/ subdirectory.
reference_data/lit_review_pilot_cache/

# Operating System files
.DS_Store
.claude/

# Notebooks
notebooks/

# Agent-generated models and tests (outputs, not source)
agent_generated/models/*
!agent_generated/models/.gitkeep
agent_generated/tests/*
!agent_generated/tests/.gitkeep
# Per-run plugin dirs (docs/run_scoped_plugins.md) — each run writes its own
# models under agent_generated/runs/<run_name>/models/; nothing in here is
# source.
agent_generated/runs/

# Local persistent memories (private to each developer's checkout).
# These are loaded by Claude via the auto-memory pointer in
# ~/.claude/projects/.../memory/MEMORY.md but are not shared in git.
docs/memories/

# Machine-specific config (copied from *.example.yaml on first checkout
# and edited locally for each machine — never tracked, so git pull won't
# clobber per-machine paths).
tidmad_data_config.yaml
dashboard_config.yaml
siderius_workspace/
fm-agent-repo/

# Per-GPU time-calibration tables for evaluate_time_skill. Default location
# is ~/.siderius/ so this is defensive — only matters when a developer points
# SIDERIUS_CALIBRATION_DIR at a path inside the repo tree.
time_calibration_*.json

# agent_generated runtime artifacts (registry state + generated loss plugins)
agent_generated/_capability_index.json
agent_generated/losses/*.py

# Test artifacts written through a MagicMock's `__fspath__`.
#
# `MagicMock` implements `__fspath__`, so `Path(sandbox.base_dir)` accepts a
# mock silently and yields a literal `MagicMock/<mock name>/<id>` path — see
# `nodes/ml_hyperparameter_tune_agent/ml_hyperparameter_tune_agent.py`'s
# prephase workspace. A test that forgets `base_dir = str(tmp_path)` then
# materialises that tree at the repo root, and 4,923 such files were once
# committed (21 MB, ~10x the whole tests/ tree) before anyone noticed.
#
# No current test produces them — verified by running the full suite against
# an mtime marker — so this is a guard against the defect returning, not a
# licence for it. `tests/unit/test_repo_hygiene.py` fails if such a path is
# ever tracked again.
MagicMock/
