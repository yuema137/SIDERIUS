# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
tidmad/
venv/
env/
*.env

# Data and Binary files 
*.npy
*.pth
*.pdf
reports/

# Operating System files
.DS_Store
.claude/

# Notebooks
notebooks/

# Agent-generated models and tests (outputs, not source)
agent_generated/models/*
!agent_generated/models/.gitkeep
agent_generated/tests/*
!agent_generated/tests/.gitkeep
# Per-run plugin dirs (docs/run_scoped_plugins.md) — each run writes its own
# models under agent_generated/runs/<run_name>/models/; nothing in here is
# source.
agent_generated/runs/

# Local persistent memories (private to each developer's checkout).
# These are loaded by Claude via the auto-memory pointer in
# ~/.claude/projects/.../memory/MEMORY.md but are not shared in git.
docs/memories/

# Machine-specific config (copied from *.example.yaml on first checkout
# and edited locally for each machine — never tracked, so git pull won't
# clobber per-machine paths).
tidmad_data_config.yaml
dashboard_config.yaml
siderius_workspace/
fm-agent-repo/

# Per-GPU time-calibration tables for evaluate_time_skill. Default location
# is ~/.siderius/ so this is defensive — only matters when a developer points
# SIDERIUS_CALIBRATION_DIR at a path inside the repo tree.
time_calibration_*.json
