# ---------------------------------------------------------------------------
# SIDERIUS — H100 resource posture (issue #261, arXiv-readiness stream S3)
# ---------------------------------------------------------------------------
# bash. SOURCE this file from the campaign launcher after `--h100`; do not
# execute it. It must stay side-effect free under `set -euo pipefail`: it
# only assigns variables, exports the environment the runtime reads, and
# defines the `H100_CHAIN_ARGS` array the launcher splats AFTER its own
# arguments (`_chain_common.sh`'s parser lets a later flag override an
# earlier one, so the posture wins).
#
# Every value below is a row of the H100 budget table in
# `docs/guides/operating-a-run.md` ("Cross-hardware bring-up (H100
# posture)"). `tests/unit/docs/test_h100_posture.py` fails when this file and
# that table disagree, when an exported name is one no production module
# reads, or when a flag is one `_chain_common.sh` would reject.
#
# Topology: ONE CHAIN PER CARD. The V19/V20 pair and queue runners
# (`v19_gate0_pair_runner.sh`, `v19_queue_runner.sh`, `v20_queue_runner.py`)
# are the PAIR topology — two chains sharing one 32 GB card — and are NOT
# used with this posture. `H100_MAX_ACTIVE_PER_CARD` documents that; nothing
# in the runtime reads it.
#
# "GB" flags are implemented as GiB (`agent/skills/evaluate_vram_skill/
# wrapper.py:87`, `_GB = 1024**3`). The nominal-spec derivations below use
# 80 GB; the card's real `total_memory` is a MEASURE row in the table, and a
# budget above the physical 80 % cap is vetoed down to that cap, never up.
# ---------------------------------------------------------------------------

# Bump on any value change; the launcher may log it beside the run.
H100_POSTURE_VERSION=1

# Table row `H100_MAX_ACTIVE_PER_CARD` — topology, not a runtime knob.
H100_MAX_ACTIVE_PER_CARD=1

# --- environment the runtime reads ----------------------------------------

# Table row `SIDERIUS_PAIR_VRAM_CEILING_GIB`: aggregate admission ceiling.
# 0.80 x 80 GB nominal. The shipped compatibility default is 28.0 GiB
# (`core/runtime_control/pair_admission.py:45`, an RTX 5090 value) and
# `core/runtime_control/admission.py` admits a phase only when the measured
# training requirement plus everything else on the card fits under
# min(this, measured capacity) — left at the default an 80 GB card is
# silently capped at 28 GiB.
export SIDERIUS_PAIR_VRAM_CEILING_GIB=64

# Table row `SIDERIUS_PREFLIGHT_WORKER_MEM_GIB`: host-RAM ceiling for ONE
# pre-flight worker (`agent/skills/evaluate_vram_skill/isolated_probe.py:98-127`).
# The shipped default, restated so the posture is explicit. Its arithmetic
# assumed two chains on a 61.8 GiB host; re-derive per host after `free -g`
# (see the table) and lower it in a posture bump if the sum does not fit.
export SIDERIUS_PREFLIGHT_WORKER_MEM_GIB=24

# Table row `SIDERIUS_SUBPROCESS_RSS_GB`: NOT SET on purpose. It is a GLOBAL
# override that replaces the per-role 40 / 60 / 24 GiB host-RSS ceilings for
# EVERY child role at once (`core/execution_calibration.py:152-213`), so it
# cannot retune one role. Fill it only after the MEASURE row (host RAM per
# chain) shows the declared roles cannot fit; `0` disables the ceiling.
# export SIDERIUS_SUBPROCESS_RSS_GB=

# Table row `SIDERIUS_GPU_VRAM_QUOTA_MIB`: NOT SET — a MEASURE row. It is the
# per-user VRAM quota the DEPLOYMENT enforces (`pair_admission.py:47-51`,
# in MiB); unknown for the H100 fleet until the fleet operator states it.
# Unset means "unknown", never "unlimited". If a quota exists, also set the
# second reader `SIDERIUS_GPU_VRAM_QUOTA_GB` (GiB, `probe_subprocess.py:105`).
# export SIDERIUS_GPU_VRAM_QUOTA_MIB=

# --- chain flags for one chain per card ------------------------------------
# Splatted by the launcher after its own args:
#   bash run_chain.sh "${LAUNCHER_ARGS[@]}" "${H100_CHAIN_ARGS[@]}"
# Workload policy (time budgets, rounds, portions, scope) stays with the
# launcher; this array carries only the resource / safety posture.
H100_CHAIN_ARGS=(
    # Table rows `--trial_vram_budget_gb` / `--formal_vram_budget_gb`:
    # 0.80 x 80 GB nominal; the effective per-attempt cap is
    # min(budget, 0.80 x measured total) (`wrapper.py:653-656`).
    --trial_vram_budget_gb 64
    --formal_vram_budget_gb 64
    # Table row `--gpu_pair_ceiling_gib`: the same aggregate ceiling as the
    # exported variable, in the run's RECORDED input. The tuner's pre-phase
    # admission reads the flag (`nodes/ml_hyperparameter_tune_agent/
    # runtime.py:266,323-331`) and only falls back to the env var when the
    # flag is absent, so the value must travel both ways.
    --gpu_pair_ceiling_gib 64
    # Table row `--gpu_admission_enforcement`: V20 production posture (M5)
    # — a resource verdict stops the phase and records an evidence gap
    # instead of proceeding into the OOM the posture exists to prevent.
    --gpu_admission_enforcement enforce_resource_limits
    # Table rows `--runtime_watchdog` … `--runtime_watchdog_floor_seconds`:
    # the V19/V20 runtime safety posture, carried unchanged. The time
    # estimator's learned correction is COLD on a new GPU name (k = 1.0),
    # so these multipliers are what protects the first H100 rounds.
    --runtime_watchdog
    --runtime_safety_factor 1.5
    --runtime_trial_safety_factor 3.0
    --runtime_formal_safety_factor 2.25
    --runtime_watchdog_safety_factor 3.5
    --runtime_watchdog_floor_seconds 120
)
