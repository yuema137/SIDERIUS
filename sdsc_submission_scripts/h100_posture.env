# ---------------------------------------------------------------------------
# SIDERIUS — H100 resource posture v3 (issues #259/#261, arXiv launch topology; v3 = #261 watchdog ruling)
# ---------------------------------------------------------------------------
# bash. SOURCE this file from the campaign launcher after `--h100`; do not
# execute it. It must stay side-effect free under `set -euo pipefail`: it
# only assigns variables, exports the environment the runtime reads, and
# defines the `H100_CHAIN_ARGS` array the launcher splats AFTER its own
# arguments (`_chain_common.sh`'s parser lets a later flag override an
# earlier one, so the posture wins).
#
# Topology (v2, author ruling 2026-08-25): FOUR CO-RESIDENT BAND CHAINS PER
# CARD. GPU A carries the WITH arm's four band chains (0-3, 4-9, 10-14,
# 15-19), GPU B the WITHOUT arm's four, GPU C is calibration/support. The
# v1 "one chain per card" posture and the older 8-GPU/10-pod fleet plan are
# SUPERSEDED. The V19/V20 pair and queue runners are the 32 GB PAIR
# topology and are still NOT used with this posture; the band fleet is
# launched by `launch_band_fleet.sh` -> `launch_prior_baseline_experiment.sh
# --band ... --workspace-root ...`.
#
# "GB" flags are implemented as GiB (`agent/skills/evaluate_vram_skill/
# wrapper.py:87`, `_GB = 1024**3`). The derivations below use the 80 GB
# nominal spec; the card's real `total_memory` is a MEASURE row, and a
# budget above the physical 80 % cap is vetoed down to that cap, never up.
#
# DOC-SYNC: Table 1 in `docs/guides/operating-a-run.md` and the pins in
# `tests/unit/docs/test_h100_posture.py` are synced per version (v2 sync
# landed with #307; v3 sync lands with the #261 watchdog ruling). Every
# superseded value is kept below as a comment marked SUPERSEDED, never
# deleted.
# ---------------------------------------------------------------------------

# Bump on any value change; the launcher may log it beside the run.
H100_POSTURE_VERSION=3

# Topology row — documentation of intent, not a runtime knob. Four band
# chains co-resident on one card. (SUPERSEDED v1: H100_MAX_ACTIVE_PER_CARD=1.)
H100_MAX_ACTIVE_PER_CARD=4

# --- 4-way co-residency parameters (launcher/preflight/fleet readers) -------
# Plain assignments, not exports: the RUNTIME does not read these names —
# the launcher, `launch_band_fleet.sh` and `campaign_preflight.sh` do.

# Number of co-resident chains this posture is derived for. Every aggregate
# below derives from it; change it and the derivations follow.
H100_CORESIDENT_CHAINS=4

# Per-chain VRAM budget in GiB (author ruling: ~18 GiB per chain, FINAL
# figure set after the GPU-C probe — edit here + bump the version, never
# scatter the number). Wired below into --trial_vram_budget_gb /
# --formal_vram_budget_gb and SIDERIUS_GPU_VRAM_QUOTA_GB.
H100_PER_CHAIN_VRAM_GB=18

# Derived aggregate admission ceiling: chains x per-chain = 72 GiB on the
# 80 GB card, leaving 8 GB for CUDA contexts, fragmentation and peak
# transients. Wired into SIDERIUS_PAIR_VRAM_CEILING_GIB and
# --gpu_pair_ceiling_gib (the value must travel both ways — see below).
H100_QUAD_AGGREGATE_VRAM_GIB=$((H100_CORESIDENT_CHAINS * H100_PER_CHAIN_VRAM_GB))

# Nominal card total + minimum headroom the preflight admission arithmetic
# requires: chains x per-chain + headroom must fit under the card total
# (`campaign_preflight.sh` fails otherwise, stating both numbers).
H100_CARD_TOTAL_VRAM_GB=80
H100_MIN_CARD_VRAM_HEADROOM_GB=6

# 4-way co-residency wall-time slowdown factor — MUST be measured by the
# GPU-C probe (`gpu_c_coresidency_probe.sh` -> gpu_c_probe_result.json,
# field `coresidency_factor`) and copied here with a version bump. EMPTY
# means unmeasured: the band launcher REFUSES a campaign (--band) --h100
# launch until it is filled. The 1.85-2.13x pairwise figure from the RTX
# 5090 pair topology is a STALE LOWER BOUND and must never be reused here.
H100_CORESIDENCY_FACTOR=

# Host-RAM preflight expectation: the recorded ~47 GB peak anonymous RSS of
# the 4-chain inspection OOM incident, plus headroom. `campaign_preflight.sh`
# requires MemAvailable >= (expected + headroom) before a fleet launch.
H100_EXPECTED_QUAD_HOST_ANON_RSS_GB=47
H100_HOST_RAM_HEADROOM_GB=16

# Default seconds between the fleet's sequential band-chain starts, so four
# cold-start VRAM probes / LLM bursts never land in the same instant
# (`launch_band_fleet.sh --stagger-seconds` overrides).
H100_FLEET_STAGGER_SECONDS=60

# --- environment the runtime reads ----------------------------------------

# `SIDERIUS_PAIR_VRAM_CEILING_GIB`: AGGREGATE admission ceiling — a chain's
# pre-phase admission admits only when its predicted peak plus everything
# else on the card fits under min(this, measured capacity)
# (`core/runtime_control/pair_admission.py:45`, shipped compatibility
# default 28.0 GiB — an RTX 5090 value; left unset an 80 GB card is
# silently capped at 28 GiB). v2 derives it as chains x per-chain = 72.
# (SUPERSEDED v1: 64 = 0.80 x 80 for ONE chain per card.)
export SIDERIUS_PAIR_VRAM_CEILING_GIB=$H100_QUAD_AGGREGATE_VRAM_GIB

# `SIDERIUS_PREFLIGHT_WORKER_MEM_GIB`: host-RAM ceiling for ONE pre-flight
# VRAM-probe worker (`agent/skills/evaluate_vram_skill/isolated_probe.py:98-127`).
# Shipped default restated — UNCHANGED in v2, deliberately: its arithmetic
# assumed two chains on a 61.8 GiB host and has NOT been re-derived for
# four co-resident chains. Worst case is 4 workers x 24 GiB if all four
# cold-starts probe simultaneously; the fleet's launch stagger
# (H100_FLEET_STAGGER_SECONDS) and the preflight's MemAvailable check are
# the current mitigations. Re-derive per host after `free -g` and lower it
# in a posture bump if the sum does not fit.
export SIDERIUS_PREFLIGHT_WORKER_MEM_GIB=24

# `SIDERIUS_GPU_VRAM_QUOTA_GB` (GiB, `core/runtime_control/
# probe_subprocess.py:105`): the per-WORKER VRAM attribution threshold — a
# probe worker whose own footprint reaches min(this, 0.9 x device) is
# classified as capacity evidence. Under 4-way co-residency a candidate
# that alone exceeds its ~18 GiB chain slot IS over capacity for this
# posture, so the per-chain budget is the correct value here.
export SIDERIUS_GPU_VRAM_QUOTA_GB=$H100_PER_CHAIN_VRAM_GB

# `SIDERIUS_SUBPROCESS_RSS_GB`: NOT SET on purpose. It is a GLOBAL override
# that replaces the per-role 40 / 60 / 24 GiB host-RSS ceilings for EVERY
# child role at once (`core/execution_calibration.py:152-213`), so it
# cannot retune one role. Fill it only after the MEASURE row (host RAM per
# chain) shows the declared roles cannot fit; `0` disables the ceiling.
# export SIDERIUS_SUBPROCESS_RSS_GB=

# `SIDERIUS_GPU_VRAM_QUOTA_MIB`: NOT SET — a MEASURE row, and in v2 also a
# NAMED MIS-WIRE HAZARD. This is the per-USER total quota an EXTERNAL
# enforcer applies (`pair_admission.py:47-51`, MiB); `pair_ceiling_gib()`
# CLAMPS the aggregate ceiling to min(ceiling, quota). All four band
# chains run as one user, so setting it to the PER-CHAIN 18 GiB would
# clamp the whole card's aggregate to 18 GiB and refuse every chain's
# admission. Set it ONLY if the H100 deployment truly enforces a per-user
# quota, to that enforced total (>= chains x per-chain, in MiB), and then
# keep SIDERIUS_GPU_VRAM_QUOTA_GB at the per-chain value — the two
# readers have DIFFERENT semantics and units.
# export SIDERIUS_GPU_VRAM_QUOTA_MIB=

# --- chain flags for four co-resident band chains per card ------------------
# Splatted by the launcher after its own args:
#   bash run_chain.sh "${LAUNCHER_ARGS[@]}" "${H100_CHAIN_ARGS[@]}"
# Workload policy (time budgets, rounds, portions, scope/band) stays with
# the launcher; this array carries only the resource / safety posture.
H100_CHAIN_ARGS=(
    # `--trial_vram_budget_gb` / `--formal_vram_budget_gb`: per-attempt
    # caps = the per-chain budget; the effective cap is
    # min(budget, 0.80 x measured total) (`wrapper.py:653-656`).
    # (SUPERSEDED v1: 64 for one chain per card.)
    --trial_vram_budget_gb "$H100_PER_CHAIN_VRAM_GB"
    --formal_vram_budget_gb "$H100_PER_CHAIN_VRAM_GB"
    # `--gpu_pair_ceiling_gib`: the same aggregate ceiling as the exported
    # variable, in the run's RECORDED input. The tuner's pre-phase
    # admission reads the flag (`nodes/ml_hyperparameter_tune_agent/
    # runtime.py:266,323-331`) and only falls back to the env var when the
    # flag is absent, so the value must travel both ways.
    # (SUPERSEDED v1: 64.)
    --gpu_pair_ceiling_gib "$H100_QUAD_AGGREGATE_VRAM_GIB"
    # `--gpu_admission_enforcement`: V20 production posture (M5) — a
    # resource verdict stops the phase and records an evidence gap instead
    # of proceeding into the OOM the posture exists to prevent. Under
    # 4-way co-residency this is what turns a neighbour's spike into a
    # refused phase rather than a card-wide OOM.
    --gpu_admission_enforcement enforce_resource_limits
    # Watchdog (v3 — operator ruling #261 / Q-07c-6, 2026-08-25): the v2
    # rows borrowed the 5090-calibrated triplet (3.5 / floor 120) for a
    # DIFFERENT device and a DIFFERENT topology — exactly what the ruling
    # bans. The posture now DECLARES the execution regime and passes NO
    # watchdog flags: `core/runtime_control/watchdog_profile.py` resolves
    # (device, regime); with no calibrated H100/four_way_coresident profile
    # it resolves the explicit UNCALIBRATED state — watchdog OFF, and the
    # runaway bound is the OUTER wall-time envelope, which the launch
    # command MUST therefore carry (`--trial_time_budget_minutes` /
    # `--formal_time_budget_minutes`, plus the qualification harness's own
    # outer `timeout`). Qualification measures real H100 values, writes the
    # measured overlay (`$SIDERIUS_CALIBRATION_DIR/runtime_profiles_<slug>
    # .json`), and only then may a reviewed row enter
    # configs/runtime_profiles.yaml. The admission-side safety factors
    # below are UNCHANGED — they pad the self-correcting time estimator
    # (cold k = 1.0 on a new GPU name) and are not the watchdog's kill
    # authority.
    --execution_regime four_way_coresident
    --runtime_safety_factor 1.5
    --runtime_trial_safety_factor 3.0
    --runtime_formal_safety_factor 2.25
)
